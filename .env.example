# heresonare.com is the confirmed production domain but is not bound yet.
# This value does not prove that DNS, HTTPS, or hosting has been configured.
SITE_URL=https://heresonare.com

# Platform is disabled until explicitly configured. Run npm run platform:setup
# for a private loopback-only local workspace. See docs/platform-operations.md.
# Production: PLATFORM_STORAGE=postgres, with a managed PostgreSQL URL.
# Use verified TLS (sslmode=verify-full) and run npm run platform:migrate.
# PLATFORM_STORAGE=postgres
# PLATFORM_ORIGIN=https://heresonare.com
# DATABASE_URL=
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_PASSWORD_HASH=
# Keep all actual credentials in ignored environment files or hosting secrets.
